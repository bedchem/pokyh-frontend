# POKYH web: example configuration.
#
# The website is a static export. Every value below is read when the site is
# BUILT (`npm run build`) and frozen into the files in out/; nothing is read at
# run time and the site holds no secrets. For local development copy this file
# to .env.local (never commit .env.local).

# ─── Site and API ────────────────────────────────────────────────────────────
# Canonical address of the website (links, sitemap, robots.txt, metadata).
# A production build never names a local address; it uses https://pokyh.com.
NEXT_PUBLIC_SITE_URL=https://pokyh.com
# The POKYH API (pokyh-backend). Must be on the same site as the website
# (pokyh.com -> api.pokyh.com), or the browser does not send the API's sign-in
# cookies. A local address is replaced by https://api.pokyh.com in a production
# build unless NEXT_PUBLIC_API_LOCAL=true.
NEXT_PUBLIC_API_BACKEND_URL=https://api.pokyh.com
# X-API-Key sent with every write; must match API_KEY of the backend.
NEXT_PUBLIC_API_KEY=
# true: keep a local API address in a production build (to test out/ against a
# backend on this machine). Never set it for a real deployment.
NEXT_PUBLIC_API_LOCAL=

# ─── Development (npm run dev) ───────────────────────────────────────────────
# `npm run dev` passes the API's paths on to the API, so its cookies land on
# localhost (next.config.ts). Where to: default NEXT_PUBLIC_API_BACKEND_URL.
# The backend's CORS_ORIGIN must include http://localhost:3011.
API_DEV_PROXY_TARGET=http://localhost:4000
# true: call the API directly instead of through the development proxy.
NEXT_PUBLIC_API_DIRECT=
# true: log every API call in the browser console.
NEXT_PUBLIC_DEBUG_API=false

# ─── Build-time data ─────────────────────────────────────────────────────────
# Where the prerendered public Mensa page reads the menu at build time
# (default: NEXT_PUBLIC_API_BACKEND_URL). The browser loads the current menu
# afterwards anyway.
MENSA_API_URL=
# Key for that read (default: NEXT_PUBLIC_API_KEY). Leave commented to use it.
# MENSA_API_KEY=

# ─── Behaviour ───────────────────────────────────────────────────────────────
# Language for browsers that ask for none of de/it/en, and hreflang x-default.
NEXT_PUBLIC_FALLBACK_LOCALE=en
# When "this week" moves on to the next one: "<weekday> <HH:MM>", local time,
# 0 = Sunday ... 6 = Saturday. Default "6 17:00".
NEXT_PUBLIC_WEEK_ROLLOVER=
# How long visited pages stay in the browser's router cache (seconds).
NEXT_STALE_DYNAMIC=60
NEXT_STALE_STATIC=300
# Optional JSON to tune the scroll feel of the public pages (lib/scroll-pace.ts),
# e.g. {"lerp":{"wheel":0.15,"precise":0.5},"gear":{"wheel":0.85},"stretch":{"hero":2}}
#   lerp: smoothing of mouse wheels / trackpads, gear: distance per input,
#   stretch: how much longer the homepage scenes are with a mouse or trackpad.
NEXT_PUBLIC_SCROLL_TUNING=
# Longest comment under a dish or reminder (the backend's limit).
NEXT_PUBLIC_COMMENT_MAX_LENGTH=2000
# Words the sign-in mascot will not say (it greets by the typed user name).
# The lists per language are in lib/word-lists/*.json; these add to them.
# Comma-separated; BLOCK words are caught anywhere in a name, ALLOW names are
# never caught (a real name that a list catches by mistake).
NEXT_PUBLIC_WORD_FILTER_BLOCK=
NEXT_PUBLIC_WORD_FILTER_ALLOW=
# Web Push public key (the backend's VAPID_PUBLIC_KEY). Empty: no push offer.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Google Analytics measurement id; loaded only after the visitor's consent.
NEXT_PUBLIC_GA_ID=

# ─── Public links ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SOURCE_URL=https://github.com/bedchem
# Support link in the settings ("POKYH unterstützen"); set it empty to hide the banner.
NEXT_PUBLIC_SUPPORT_URL=https://buymeacoffee.com/plattnericus

# ─── Search engines ──────────────────────────────────────────────────────────
# Google Search Console verification token (optional).
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools verification token (optional, msvalidate.01).
BING_SITE_VERIFICATION=
# IndexNow key (optional, 8-128 letters, digits or dashes): served at
# /indexnow.txt; `npm run indexnow` then pings Bing, Yandex & co. after a deploy.
INDEXNOW_KEY=
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow
# Content-Signal line in robots.txt. Leave commented for the default.
# CONTENT_SIGNALS=search=yes, ai-input=yes, ai-train=yes

# ─── Legal identity ──────────────────────────────────────────────────────────
# Public legal identity. The service is offered as "POKYH" (LEGAL_OPERATOR_NAME).
# There is no registered company behind it; a private individual runs it, so
# LEGAL_ENTITY_NAME (shown once, as the GDPR controller in the privacy notice)
# must be that person's name, never a company form like "GmbH" or "S.r.l.".
# No postal address is published; leave the address lines empty unless POKYH
# becomes a commercial service. If POKYH is ever incorporated, fill in the
# representative/VAT/register fields below; until then, do not invent them.
LEGAL_OPERATOR_NAME=POKYH
# Required: a production build stops without it.
LEGAL_ENTITY_NAME=
LEGAL_ADDRESS_LINE_1=
LEGAL_ADDRESS_LINE_2=
LEGAL_CONTACT_EMAIL=contact@pokyh.com
LEGAL_PRIVACY_EMAIL=contact@pokyh.com
LEGAL_REPRESENTATIVE=
LEGAL_VAT_ID=
LEGAL_COMPANY_REGISTER=
LEGAL_REA_NUMBER=
LEGAL_PEC=
